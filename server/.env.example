# Porta da API
PORT=3333

# URL pública do frontend (usada em links de e-mail e no QR code do certificado)
APP_URL=http://localhost:5173

# Troque obrigatoriamente em produção (ex.: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo

# Banco SQLite e diretório de uploads (relativos à pasta server/)
DATABASE_PATH=data/multiverso.db
UPLOADS_DIR=uploads

# Fuso usado para calcular dias de estudo (streak) e relatórios
APP_TIMEZONE=America/Sao_Paulo

# Administrador criado pelo seed
ADMIN_NAME=Administrador Multiverso
ADMIN_EMAIL=admin@multiverso.rpv
ADMIN_PASSWORD=admin12345

# SMTP — se SMTP_HOST ficar vazio, os e-mails são apenas registrados
# (console + tela "E-mails" do painel administrativo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Multiverso Rio Pomba Valley <nao-responda@multiverso.rpv>"
